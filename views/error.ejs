<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  <title>Something Went Wrong</title>
</head>
<body class="bg-slate-800 text-white min-h-screen flex items-center justify-center">

  <div class="w-full max-w-xl mx-auto px-6">
    
    <div class="bg-slate-900 border border-slate-700 rounded-2xl p-10 text-center shadow-xl">
      
      <!-- Icon -->
      <div class="flex justify-center mb-6">
        <div class="w-16 h-16 flex items-center justify-center rounded-full bg-red-500/10 border border-red-500/30">
          <svg xmlns="http://www.w3.org/2000/svg" 
               class="h-8 w-8 text-red-500" 
               fill="none" 
               viewBox="0 0 24 24" 
               stroke="currentColor">
            <path stroke-linecap="round" 
                  stroke-linejoin="round" 
                  stroke-width="2" 
                  d="M12 9v2m0 4h.01M5.07 19h13.86c1.54 0 2.5-1.67 
                  1.73-3L13.73 4c-.77-1.33-2.69-1.33-3.46 
                  0L3.34 16c-.77 1.33.19 3 1.73 3z" />
          </svg>
        </div>
      </div>

      <!-- Title -->
      <h1 class="text-3xl font-semibold mb-3">
        Something Went Wrong
      </h1>

      <!-- Message -->
      <p class="text-slate-400 mb-8">
        We encountered an unexpected error while processing your request.
        Please return to the homepage.
      </p>

      <!-- Home Button -->
      <a href="/home"
         class="inline-block px-6 py-3 bg-indigo-600 rounded-md font-medium hover:bg-indigo-700 transition focus:ring-2 focus:ring-indigo-500">
        Go to Home
      </a>

    </div>

  </div>

</body>
</html>
