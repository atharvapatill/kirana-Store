<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <title>Dashboard</title>
  </head>

  <body class="bg-slate-800 text-white min-h-screen">

    <!-- Navbar -->
    <nav class="bg-slate-900 border-b border-slate-800">
      <div class="max-w-7xl mx-auto px-6 py-4 grid grid-cols-3 items-center">
        
        <div></div>

        <div class="flex justify-between w-[360px] mx-auto p-1">
          <a href="#" class="text-base font-semibold text-white border-b-2 border-indigo-500 pb-1">
            Home
          </a>
          <a href="/customerdashboard"  class="text-base font-medium text-slate-300 hover:text-white transition">
            Customers
          </a>
          <a href="/productdashboard" class="text-base font-medium text-slate-300 hover:text-white transition">
            Products
          </a>
        </div>

        <div class="flex justify-end">
          <form action="/api/logout" method="POST">
            <button class="px-4 py-2 text-sm font-medium rounded-md bg-[#b35973] hover:bg-[#c36a84] transition">Log out</button>
          </form>
        </div>

      </div>
    </nav>

    <!-- Page Content -->
    <main class="max-w-6xl mx-auto px-4 py-10">

      <!-- Total Credit Card (Centered) -->

      <div class="bg-slate-900 border border-slate-700 rounded-xl p-10 mb-10 text-center">
        <p class="text-slate-400 text-sm uppercase tracking-wide">
          Total Credit
        </p>
        <h1 class="text-5xl font-semibold mt-3 text-indigo-400">
          ₹<%= totalcredit %>
        </h1>
      </div>

      <!-- Credit Table -->
      <div class="bg-slate-900 border border-slate-700 rounded-xl overflow-hidden">
        <table class="w-full text-left">
          <thead class="bg-slate-800 text-slate-300">
            <tr>
              <th class="px-6 py-3 text-sm font-medium">ID</th>
              <th class="px-6 py-3 text-sm font-medium">Name</th>
              <th class="px-6 py-3 text-sm font-medium">Credit</th>
              <th class="px-6 py-3 text-sm font-medium text-center">Action</th>
            </tr>
          </thead>

          <tbody class="divide-y divide-slate-700">

            <!-- Table Rows  -->
            <% for( let index = 0; index < customers.length; index++ ) { %>
              <tr class="hover:bg-slate-800 transition">
                <td class="px-6 py-4">
                  <a href="customer/<%=customers[index]._id%>" class="block text-slate-300 hover:text-slate-300 cursor-pointer">
                    <%= index+1%>
                  </a>
                </td>
                <td class="px-6 py-4">
                  <a href="/customer/<%= customers[index]._id %>"
                    class="hover:text-slate-300 no-underline">
                    <%= customers[index].name %>
                  </a>
                </td>
                <td class="px-6 py-4">₹<%= customers[index].credit%></td>
                <td class="px-6 py-4 text-center">
                  <button class="px-4 py-1.5 text-sm rounded-md bg-indigo-600 hover:bg-indigo-700 transition">
                  <a href="/api/sendreminder/<%= customers[index]._id %>" >
                    Send Reminder
                  </button>

                  
                </td>
              </tr>
            <% } %>

          </tbody>
        </table>
      </div>

    </main>

  </body>
</html>
