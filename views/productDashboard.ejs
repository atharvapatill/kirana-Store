<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <title>Product Dashboard</title>
  </head>

  <body class="bg-slate-800 text-white min-h-screen">

    <!-- Navbar -->
    <nav class="bg-slate-900 border-b border-slate-800">
      <div class="max-w-7xl mx-auto px-6 py-4 grid grid-cols-3 items-center">
        
        <div></div>

        <div class="flex justify-between w-[360px] mx-auto p-1">
          <a href="/home" class="text-base font-medium text-slate-300 hover:text-white transition">Home</a>
          <a href="/customerdashboard" class="text-base font-medium text-slate-300 hover:text-white transition">Customers</a>
          <a href="#" class="text-base font-semibold text-white border-b-2 border-indigo-500 pb-1">Products</a>
        </div>

        <div class="flex justify-end">
          <form action="/api/logout" method="POST">
            <button class="px-4 py-2 text-sm font-medium rounded-md bg-[#b35973] hover:bg-[#c36a84] transition">Log out</button>
          </form>
        </div>

      </div>
    </nav>
    
    
    <!-- Page Content -->
    <main class="max-w-6xl mx-auto px-4 py-10">
      <div class="bg-slate-900 border border-slate-700 rounded-xl p-6 mb-6">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    
    <div>
      <h2 class="text-xl font-semibold">Add New Product</h2>
      <p class="text-slate-400 text-sm mt-1">
        Create and manage your product inventory
      </p>
    </div>

    <a
      href="/addProduct"
      class="px-6 py-3 bg-indigo-600 rounded-md font-medium hover:bg-indigo-700 transition focus:ring-2 focus:ring-indigo-500"
    >
      + Add Product
    </a>

  </div>
</div>

      <!-- Search + Add Product -->
      <form action="/productdashboard" method="get">
              <div class="flex flex-col lg:flex-row gap-4 mb-8">

        <!-- Search Section -->
        <div class="flex-1 bg-slate-900 border border-slate-700 rounded-xl p-6">
          <div class="flex flex-col sm:flex-row gap-4">
            <input
              name="productName"
              type="text"
              placeholder="Search product..."
              class="flex-1 p-2 bg-slate-800 border border-slate-700 rounded-md focus:ring-1 focus:ring-indigo-500 focus:outline-none"
            />
            <button
              type="submit" class="px-6 py-2 bg-indigo-600 rounded-md font-medium hover:bg-indigo-700 focus:ring-2 focus:ring-indigo-500"
            >
              Search
            </button>
          </div>
        </div>

      </div>
      </form>


      <!-- Table Section -->
      <div class="bg-slate-900 border border-slate-700 rounded-xl overflow-hidden">
        <table class="w-full text-left">
          <thead class="bg-slate-800 text-slate-300">
            <tr>
              <th class="px-6 py-3 text-sm font-medium">ID</th>
              <th class="px-6 py-3 text-sm font-medium">Name</th>
              <th class="px-6 py-3 text-sm font-medium">Quantity</th>
              <th class="px-6 py-3 text-sm font-medium">Price</th>
              <th class="px-6 py-3 text-sm font-medium text-center">Actions</th>
            </tr>
          </thead>

          <tbody class="divide-y divide-slate-700">
            <% for( let index = 0; index < products.length; index++ ) { %>
              <% if(products[index].isDeleted == true){ %>
                <% continue %>
             <% }  %>
              <tr class="hover:bg-slate-800 transition">
                <td class="px-6 py-4"><%=index+1 %></td>
                <td class="px-6 py-4"><%=products[index].name %></td>
                <td class="px-6 py-4"><%=products[index].quantity %></td>
                <td class="px-6 py-4">₹<%=products[index].price %></td>
                <td class="px-6 py-4 flex justify-center gap-3">
                  <button class="px-3 py-1.5 text-sm rounded-md bg-indigo-600 hover:bg-indigo-700 transition">
                     <a href="updateproduct/<%= products[index]._id %>" class="block hover:text-slate-300 cursor-pointer">
                        Update
                  </button>
                  <button class="px-3 py-1.5 text-sm rounded-md bg-red-600 hover:bg-red-700 transition">
                      <a href="/api/deleteproduct/<%= products[index]._id %>" class="block hover:text-slate-300 cursor-pointer">
                        Delete
                  </button>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>

    </main>

  </body>
</html>
