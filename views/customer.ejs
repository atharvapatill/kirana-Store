<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  <title>Customer Details</title>
</head>
<body class="bg-slate-800 text-white min-h-screen">

  <!-- Navbar -->
  <nav class="bg-slate-900 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-6 py-4 grid grid-cols-3 items-center">
      <div></div>
      <div class="flex justify-between w-[360px] mx-auto p-1">
        <a href="/home" class="text-base font-medium text-slate-300 hover:text-white transition">Home</a>
        <a href="/customerdashboard" class="text-base font-medium text-slate-300 hover:text-white transition">Customers</a>
        <a href="/productdashboard" class="text-base font-medium text-slate-300 hover:text-white transition">Products</a>
      </div>

        <div class="flex justify-end">
          <form action="/api/logout" method="POST">
            <button class="px-4 py-2 text-sm font-medium rounded-md bg-[#b35973] hover:bg-[#c36a84] transition">Log out</button>
          </form>
        </div>
        
    </div>
  </nav>

  <!-- Page Content -->
  <main class="max-w-6xl mx-auto px-4 py-10">

    <!-- Customer Header -->
    <div class="flex flex-col md:flex-row justify-between items-center bg-slate-900 border border-slate-700 rounded-xl p-6 mb-8">
      <div>
        <h2 class="text-2xl font-semibold"><%= customerDetails.name  %></h2>
        <p class="text-slate-400 mt-1"><%= customerDetails.email  %></p>
      </div>
      <div class="mt-4 md:mt-0 flex flex-col md:flex-row gap-6 text-center">
        <div>
          <span class="text-slate-400">Purchase Made</span>
          <p class="text-lg font-medium">₹<%= customerDetails.purchaseMade  %></p>
        </div>
        <div>
          <span class="text-slate-400">Credit</span>
          <p class="text-lg font-medium">₹<%= customerDetails.credit  %></p>
        </div>
      </div>
    </div>

    <!-- Buy Product + Make Payment -->
    <div class="flex flex-col lg:flex-row gap-6 mb-8">

      <!-- Buy Product -->
      <div class="w-full lg:flex-[7] bg-slate-900 border border-slate-700 rounded-xl p-6">
        <h3 class="text-lg font-semibold mb-4">Buy Product</h3>
        <form action="/addorder/<%= customerDetails._id  %>" method="post">
         <div class="flex gap-4">
          <input type="number" placeholder="Enter quantity" min="1" name="noOfProducts"
            class="flex-1 p-2 bg-slate-800 border border-slate-700 rounded-md focus:ring-1 focus:ring-indigo-500 focus:outline-none"/>
          <button type="submit" class="px-6 py-2 bg-indigo-600 rounded-md font-medium hover:bg-indigo-700 focus:ring-2 focus:ring-indigo-500">
            Buy
          </button>
        </div>
        </form>

      </div>

      <!-- Make Payment -->
      <div class="w-full lg:flex-[3] bg-slate-900 border border-slate-700 rounded-xl p-6 flex items-center justify-center">
        <div class="text-center w-full">
          <h3 class="text-lg font-semibold mb-4">Make Payment</h3>
          <a href="/payment/<%= customerDetails._id  %>"
             class="w-full block px-6 py-3 bg-indigo-600 rounded-md font-medium hover:bg-indigo-700 focus:ring-2 focus:ring-indigo-500 text-center">
             Pay
          </a>
        </div>
      </div>
    </div>

    <!-- Orders Section -->
    <div class="bg-slate-900 border border-slate-700 rounded-xl overflow-hidden">
      <table class="w-full text-left">
        <thead class="bg-slate-800 text-slate-300">
          <tr>
            <th class="px-6 py-3 text-sm font-medium">Product Name</th>
            <th class="px-6 py-3 text-sm font-medium">Quantity</th>
            <th class="px-6 py-3 text-sm font-medium">Price</th>
            <th class="px-6 py-3 text-sm font-medium">Total</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-700">

          <!-- ORDER 1 -->
          <% for( let i = 0; i < orders.length; i++ ) { %>
            
            <% let totalquantity = 0 %>
            <% let totalPrice = 0 %>
            
            <tr class="bg-slate-800">
              <td colspan="4" class="px-6 py-3 text-indigo-400 font-semibold">
                <!-- Purchase Date : <%= new Date(orders[i].createdAt).toDateString() %> -->
                 Order <%= orders.length-i %>
              </td>
            </tr>

              <% for( let j = 0; j < orders[i].products.length; j++ ) { %>
                <tr class="hover:bg-slate-800">
                  <td class="px-6 py-4"><%= orders[i].products[j].productname %></td>
                  <td class="px-6 py-4"><%= orders[i].products[j].quantity %></td>
                  <td class="px-6 py-4">₹<%= orders[i].products[j].price %></td>
                  <td class="px-6 py-4 font-medium">₹<%= orders[i].products[j].quantity * orders[i].products[j].price%></td>
                </tr>
                <% totalquantity += orders[i].products[j].quantity %>
                <% totalPrice += orders[i].products[j].quantity * orders[i].products[j].price %>
              <% } %>

            <tr class="bg-slate-800 text-indigo-400 font-semibold">
              <td class="px-6 py-4 text-right">Total Quantity:</td>
              <td class="px-6 py-4"><%= totalquantity %></td>
              <td class="px-6 py-4 text-right">Order Total:</td>
              <td class="px-6 py-4">₹<%= totalPrice %></td>
            </tr>
            <% if (i !== orders.length-1){ %>
                <tr>
                  <td colspan="4" class="h-6 bg-slate-900"></td>
                </tr>
            <% } %>

          <% } %>

        </tbody>
      </table>
    </div>

  </main>

</body>
</html>
