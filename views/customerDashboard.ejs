<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <title>Customer Dashboard</title>
  </head>

  <body class="bg-slate-800 text-white min-h-screen">

    <!-- Navbar -->
    <nav class="bg-slate-900 border-b border-slate-800">
      <div class="max-w-7xl mx-auto px-6 py-4 grid grid-cols-3 items-center">
        
        <div></div>

        <div class="flex justify-between w-[360px] mx-auto p-1">
          <a href="/home" class="text-base font-medium text-slate-300 hover:text-white transition">Home</a>
          <a href="#" class="text-base font-semibold text-white border-b-2 border-indigo-500 pb-1">Customers</a>
          <a href="/productdashboard" class="text-base font-medium text-slate-300 hover:text-white transition">Products</a>
        </div>

        <div class="flex justify-end">
          <form action="/api/logout" method="POST">
            <button class="px-4 py-2 text-sm font-medium rounded-md bg-[#b35973] hover:bg-[#c36a84] transition">Log out</button>
          </form>
        </div>

      </div>
    </nav>

    <!-- Page Content -->
    <main class="max-w-6xl mx-auto px-4 py-10">

      <!-- Add New Customer Card -->
      <div class="bg-slate-900 border border-slate-700 rounded-xl p-6 mb-6">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
          
          <div>
            <h2 class="text-xl font-semibold">Add New Customer</h2>
            <p class="text-slate-400 text-sm mt-1">
              Create and manage your customer list
            </p>
          </div>

          <a
            href="/addcustomer"
            class="px-6 py-3 bg-indigo-600 rounded-md font-medium hover:bg-indigo-700 transition focus:ring-2 focus:ring-indigo-500"
          >
            + Add Customer
          </a>

        </div>
      </div>

      <!-- Search Customer Section -->
      <form action="/customerdashboard" method="get">
      <div class="flex flex-col lg:flex-row gap-4 mb-8">
          <div class="flex-1 bg-slate-900 border border-slate-700 rounded-xl p-6">
            <div class="flex flex-col sm:flex-row gap-4">
              <input
                name="email"
                type="email"
                placeholder="Search customer By Email..."
                class="flex-1 p-2 bg-slate-800 border border-slate-700 rounded-md focus:ring-1 focus:ring-indigo-500 focus:outline-none"
              />
              <button
                class="px-6 py-2 bg-indigo-600 rounded-md font-medium hover:bg-indigo-700 focus:ring-2 focus:ring-indigo-500"
              >
                Search
              </button>
            </div>
          </div>
      </div>
      </form>

      <!-- Customer Table -->
      <div class="bg-slate-900 border border-slate-700 rounded-xl overflow-hidden">
        <table class="w-full text-left">
          <thead class="bg-slate-800 text-slate-300">
            <tr>
              <th class="px-6 py-3 text-sm font-medium">ID</th>
              <th class="px-6 py-3 text-sm font-medium">Name</th>
              <th class="px-6 py-3 text-sm font-medium">Email</th>
              <th class="px-6 py-3 text-sm font-medium">Credit</th>
              <th class="px-6 py-3 text-sm font-medium text-center">Actions</th>
            </tr>
          </thead>

          <tbody class="divide-y divide-slate-700">

            <!-- Row 1 -->
             <% for( let index = 0; index < customers.length; index++ ) { %>
              <tr class="hover:bg-slate-800 transition">
                <td class="px-6 py-4">
                  <a href="customer/<%= customers[index]._id %>" class="block text-slate-300 hover:text-slate-300 cursor-pointer">
                    <%= index+1 %>
                  </a>
                </td>
                <td class="px-6 py-4">
                    <a href="customer/<%= customers[index]._id %>" class="block hover:text-slate-300 cursor-pointer"><%= customers[index].name %></td>
                <td class="px-6 py-4"><%= customers[index].email %></td>
                <td class="px-6 py-4">₹<%= customers[index].credit %></td>
                <td class="px-6 py-4 text-center">
                  <button class="px-4 py-1.5 text-sm rounded-md bg-indigo-600 hover:bg-indigo-700 transition">
                      <a href="edit/<%= customers[index]._id %>" class="block hover:text-slate-300 cursor-pointer">
                    Edit
                  </a>
                  </button>
                </td>
              </tr>
             <% } %>

          </tbody>
        </table>
      </div>

    </main>

  </body>
</html>
