<!doctype html>
<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <title>Payment</title>
  </head>

  <body class="bg-slate-800 text-white min-h-screen">
    <!-- Navbar -->
    <nav class="bg-slate-900 border-b border-slate-800">
      <div class="max-w-7xl mx-auto px-6 py-4 grid grid-cols-3 items-center">
          
        <!-- Left spacer -->
        <div></div>

        <!-- Centered, evenly spaced nav -->
        <div class="flex justify-between w-[360px] mx-auto p-1">
          <a href="/home" class="text-base font-medium text-slate-300 hover:text-white transition">Home</a>
          <a href="/customerdashboard" class="text-base font-medium text-slate-300 hover:text-white transition">Customers</a>
          <a href="/productdashboard class="text-base font-medium text-slate-300 hover:text-white transition">Products</a>
        </div>

        <!-- Right: Logout -->
        <div class="flex justify-end">
          <form action="/api/logout" method="POST">
            <button class="px-4 py-2 text-sm font-medium rounded-md bg-[#b35973] hover:bg-[#c36a84] transition">Log out</button>
          </form>
        </div>

      </div>
    </nav>

    <!-- Page Content -->
    <main class="flex justify-center items-center px-4 py-10 min-h-[calc(100vh-80px)]">
      
      <div class="bg-slate-900 border border-slate-700 rounded-xl p-8 w-full max-w-md text-center">
        <h2 class="text-2xl font-semibold mb-6">Payment</h2>

        <!-- Amount Display -->
        <div class="text-3xl font-bold mb-6">
          Amount: ₹<%= customer.credit  %>
        </div>

        <!-- Enter Amount -->
        <form action="/api/reducecredit/<%= customer._id  %>" method="post">
        <div class="mb-6">
          <label class="block mb-1 text-slate-300 font-medium">Enter Amount</label>
          <input
            name="amount"
            type="number"
            max="<%= customer.credit  %>"
            min="0"
            placeholder="Enter amount"
            class="w-full p-2 bg-slate-800 border border-slate-700 rounded-md focus:ring-1 focus:ring-indigo-500 focus:outline-none text-white"
          />
        </div>

        <!-- Buttons -->
        <div class="flex justify-center gap-4">

          <button
          type="submit"
            class="px-6 py-2.5 bg-indigo-600 rounded-md font-medium hover:bg-indigo-700 focus:ring-2 focus:ring-indigo-500"
          >
            Pay
          </button>

          <button
            class="px-6 py-2.5 bg-gray-700 rounded-md font-medium hover:bg-gray-600 focus:ring-2 focus:ring-gray-500"
          >
          
          <a href="/customer/<%= customer._id  %>">Pay Later</a>

          </button>

        </div>
        </form>
      </div>

    </main>

  </body>
</html>
